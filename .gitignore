# OS / editor clutter
.DS_Store
.*.sw?
*~
~$*

# Slide decks are not kept in the repository
*.key
*.ppt
*.pptx
Reference/Presentations/

# Python / Node build artefacts
__pycache__/
*.pyc
node_modules/
package-lock.json

# R
.Rhistory
.RData

# Secrets never go in git. Keys live outside the repository, in
# ~/.config/computervision_sentinel/secrets.env (Docs/data_ethics.md).
.env
*.env
secrets.*
keys.txt

# Local working log of decisions and issues (open items are kept in the topic docs in Docs/)
Docs/decisions_and_issues.md

# ./flight --execute_flight runs: one EXECUTION-<n>/ folder per run, regenerated from code;
# large, and holds Reddit text (see Docs/data_ethics.md)
RESULTS_FINAL/

# Scratch pipeline runs (re-created by run_all.sh; published outputs live in Data/<dataset>/)
Scripts/reddit_analysis/output/
Scripts/reddit_analysis/scripts/output
Scripts/reporting/node_modules/

# Reddit snippets kept only for local precision checks (contain user text)
Data/cv_pilot_2026-10/**/_local_audit_do_not_share/

# Blind review lists (blind_review.py make); the answers end up in the two manual_review files
Scripts/reddit_analysis/manual_review/blind/

# Anything a notebook makes (Notebooks/_setup.py out_dir()), and editor checkpoints
Notebooks/_out/
.ipynb_checkpoints/

# Project virtual environment
.venv/

# November midpoint update (.docx and its Markdown copy): kept local until it is sent;
# ./flight rebuilds both into RESULTS_FINAL/EXECUTION-<n>/report/
Deliverables/2026-11_midpoint/
